diff --git a/client/src/services/player/managers/SeekControlManager.ts b/client/src/services/player/managers/SeekControlManager.ts
new file mode 100644
index 0000000..1ea8d68
--- /dev/null
+++ b/client/src/services/player/managers/SeekControlManager.ts
@@ -0,0 +1,315 @@
+
+import DPlayer from 'dplayer';
+
+import PlayerManager from '@/services/player/PlayerManager';
+import useSettingsStore from '@/stores/SettingsStore';
+
+
+/**
+ * ビデオ視聴時のスキップ (秒送り/秒戻し) ボタンと高速シーク、再生速度の永続化を提供する PlayerManager
+ * ローカル改造 (2026-11-13): 家庭用レコーダー風の操作系を追加するために新設
+ * - コントロールバーに [30秒戻し] [10秒戻し] [再生] [10秒送り] [30秒送り] の並びでボタンを配置する
+ *   (中央の再生ボタンの隣が 10秒戻し / 30秒送り になる初期配置)
+ * - 短押し: 設定秒数のスキップ (連続タップは 220ms 以内を合算して 1 回のシークにまとめる)
+ * - 長押し (480ms 以上): 8倍相当の高速シーク (0.25 秒ごとに 2 秒進める/戻す、音声はミュート)
+ * - 再生速度の変更を検知し、ビデオ視聴用に設定へ保存する (次回再生時に復元される。ライブ視聴には適用しない)
+ */
+class SeekControlManager implements PlayerManager {
+
+    // ユーザー操作により DPlayer 側で画質が切り替わった際、この PlayerManager の再起動が必要かどうかを PlayerController に示す値
+    public readonly restart_required_when_quality_switched = false;
+
+    // 高速シークとみなす長押し時間 (ミリ秒)
+    private static readonly HOLD_THRESHOLD_MS = 480;
+    // 高速シークのシーク間隔 (ミリ秒) と 1 回あたりの移動量 (秒)。250ms ごとに 2 秒 = 8 倍相当
+    private static readonly FAST_SEEK_INTERVAL_MS = 250;
+    private static readonly FAST_SEEK_STEP_SECONDS = 2;
+    // 連続タップの合算ウィンドウ (ミリ秒)
+    private static readonly SKIP_COALESCE_MS = 220;
+    // 永続化対象の再生速度 (これ以外の値への変更は保存しない)
+    private static readonly PERSISTED_RATES = [0.75, 1, 1.25, 1.5, 1.75, 2];
+
+    // DPlayer のインスタンス
+    private readonly player: DPlayer;
+
+    // 再生モード (Live: ライブ視聴, Video: ビデオ視聴)
+    private readonly playback_mode: 'Live' | 'Video';
+
+    // 追加したボタン要素
+    private buttons: HTMLDivElement[] = [];
+
+    // 合算待ちのスキップ量 (秒) と、その適用タイマー
+    private pending_skip_seconds = 0;
+    private skip_timer: ReturnType<typeof setTimeout> | null = null;
+
+    // 高速シーク中かどうかと、そのタイマー類
+    private is_fast_seeking = false;
+    private fast_seek_timer: ReturnType<typeof setInterval> | null = null;
+    private was_muted_before_fast_seek = false;
+
+    // ratechange イベントのハンドラー (destroy 時に解除するため保持)
+    private rate_change_handler: (() => void) | null = null;
+
+    /**
+     * コンストラクタ
+     * @param player DPlayer のインスタンス
+     * @param playback_mode 再生モード (Live: ライブ視聴, Video: ビデオ視聴)
+     */
+    constructor(player: DPlayer, playback_mode: 'Live' | 'Video') {
+        this.player = player;
+        this.playback_mode = playback_mode;
+    }
+
+
+    /**
+     * スキップボタンの追加と再生速度の永続化セットアップを行う
+     */
+    public async init(): Promise<void> {
+
+        // ビデオ視聴時のみ有効 (ライブ視聴では登録自体されないが、念のためガードする)
+        if (this.playback_mode !== 'Video') {
+            return;
+        }
+
+        const settings_store = useSettingsStore();
+
+        // 万が一すでにボタンが存在していた場合は削除する
+        for (const element of this.player.container.querySelectorAll('.dplayer-skip-icon')) {
+            element.remove();
+        }
+        this.buttons = [];
+
+        // 再生ボタンの要素を基準に、その前後にスキップボタンを挿入する
+        const play_icon = this.player.container.querySelector('.dplayer-play-icon');
+        if (play_icon === null) {
+            console.warn('[SeekControlManager] Play icon not found. Skip buttons are disabled.');
+            return;
+        }
+
+        const backward_seconds = settings_store.settings.video_seek_backward_seconds;
+        const forward_seconds = settings_store.settings.video_seek_forward_seconds;
+
+        // 再生ボタンの前に 30秒戻し / (設定秒数)戻し を挿入
+        const back_large = this.createSkipButton(-30, '30秒戻し');
+        const back_small = this.createSkipButton(-backward_seconds, `${backward_seconds}秒戻し`);
+        play_icon.before(back_large, back_small);
+        // 再生ボタンの後に (設定秒数)送り / 30秒送り を挿入
+        const forward_small = this.createSkipButton(forward_seconds, `${forward_seconds}秒送り`);
+        const forward_large = this.createSkipButton(30, '30秒送り');
+        play_icon.after(forward_small, forward_large);
+        this.buttons = [back_large, back_small, forward_small, forward_large];
+
+        // 前回保存された再生速度を復元する (PlayerController 側で明示指定された場合はそちらが優先されるため、
+        // ここでは現在の再生速度がデフォルト (1倍) の場合のみ適用する)
+        const saved_rate = settings_store.settings.video_playback_rate;
+        if (SeekControlManager.PERSISTED_RATES.includes(saved_rate) && saved_rate !== 1 &&
+            Math.abs(this.player.video.playbackRate - 1) < 0.001) {
+            this.player.speed(saved_rate);
+        }
+
+        // 再生速度の変更を検知して設定に保存する
+        // playbackRate = 0 のような一時的な変更 (コメント固定表示など) は対象外とする
+        this.rate_change_handler = () => {
+            const rate = this.player.video.playbackRate;
+            if (SeekControlManager.PERSISTED_RATES.some((persisted) => Math.abs(persisted - rate) < 0.001)) {
+                const store = useSettingsStore();
+                if (Math.abs(store.settings.video_playback_rate - rate) >= 0.001) {
+                    store.settings.video_playback_rate = rate;
+                }
+            }
+        };
+        this.player.video.addEventListener('ratechange', this.rate_change_handler);
+
+        console.log('[SeekControlManager] Initialized.');
+    }
+
+
+    /**
+     * 追加したボタンとイベントを破棄する
+     */
+    public async destroy(): Promise<void> {
+        this.stopFastSeek();
+        if (this.skip_timer !== null) {
+            clearTimeout(this.skip_timer);
+            this.skip_timer = null;
+        }
+        this.pending_skip_seconds = 0;
+        for (const button of this.buttons) {
+            button.remove();
+        }
+        this.buttons = [];
+        if (this.rate_change_handler !== null) {
+            this.player.video.removeEventListener('ratechange', this.rate_change_handler);
+            this.rate_change_handler = null;
+        }
+    }
+
+
+    /**
+     * スキップボタンの HTML 要素を生成し、押下イベントを登録する
+     * @param delta_seconds スキップ量 (秒、負数で戻し)
+     * @param label ボタンの aria-label
+     */
+    private createSkipButton(delta_seconds: number, label: string): HTMLDivElement {
+        const button = document.createElement('div');
+        button.className = 'dplayer-icon dplayer-skip-icon';
+        button.setAttribute('aria-label', label);
+        button.setAttribute('data-balloon-nofocus', '');
+        button.setAttribute('data-balloon-pos', 'up');
+        // Android TV のリモコン等でフォーカス移動・決定操作できるよう、ボタンとしてフォーカス可能にする
+        button.setAttribute('tabindex', '0');
+        button.setAttribute('role', 'button');
+        const seconds = Math.abs(delta_seconds);
+        const flip = delta_seconds > 0 ? ' transform="scale(-1,1) translate(-24,0)"' : '';
+        button.innerHTML = `
+            <span class="dplayer-icon-content">
+                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
+                    <g${flip}>
+                        <path d="M12 5V1.8L6.8 6 12 10.2V7c3.3 0 6 2.7 6 6s-2.7 6-6 6-6-2.7-6-6H4c0 4.4 3.6 8 8 8s8-3.6 8-8-3.6-8-8-8z"></path>
+                    </g>
+                    <text x="12" y="17.2" font-size="6.8" font-weight="700" text-anchor="middle" fill="#ffffff">${seconds}</text>
+                </svg>
+            </span>
+        `;
+
+        let hold_timer: ReturnType<typeof setTimeout> | null = null;
+        let pointer_is_down = false;
+        let fast_seek_started = false;
+
+        button.addEventListener('pointerdown', (event) => {
+            event.preventDefault();
+            pointer_is_down = true;
+            fast_seek_started = false;
+            hold_timer = setTimeout(() => {
+                if (pointer_is_down === false) return;
+                fast_seek_started = true;
+                this.startFastSeek(delta_seconds > 0 ? 1 : -1);
+            }, SeekControlManager.HOLD_THRESHOLD_MS);
+        });
+
+        const finish_pointer = (event: Event) => {
+            if (pointer_is_down === false) return;
+            pointer_is_down = false;
+            if (hold_timer !== null) {
+                clearTimeout(hold_timer);
+                hold_timer = null;
+            }
+            if (fast_seek_started) {
+                fast_seek_started = false;
+                this.stopFastSeek();
+                event.preventDefault();
+            } else if (event.type === 'pointerup') {
+                this.queueSkip(delta_seconds);
+            }
+        };
+        button.addEventListener('pointerup', finish_pointer);
+        button.addEventListener('pointercancel', finish_pointer);
+        button.addEventListener('pointerleave', finish_pointer);
+        // pointer イベントで処理するため、click は伝播だけ止める
+        button.addEventListener('click', (event) => {
+            event.preventDefault();
+            event.stopPropagation();
+        });
+        // リモコン・キーボードの決定キー (Enter / Space) でもスキップできるようにする
+        // キーリピート (長押し) 時は OS 側のリピートで連続スキップになる
+        button.addEventListener('keydown', (event) => {
+            if (event.code === 'Enter' || event.code === 'Space') {
+                event.preventDefault();
+                event.stopPropagation();
+                this.queueSkip(delta_seconds);
+            }
+        });
+
+        return button;
+    }
+
+
+    /**
+     * スキップを合算キューに入れ、短時間に連続した操作を 1 回のシークにまとめる
+     * @param delta_seconds スキップ量 (秒、負数で戻し)
+     */
+    private queueSkip(delta_seconds: number): void {
+        this.pending_skip_seconds += delta_seconds;
+        if (this.skip_timer !== null) {
+            clearTimeout(this.skip_timer);
+        }
+        this.skip_timer = setTimeout(() => {
+            this.skip_timer = null;
+            const delta = this.pending_skip_seconds;
+            this.pending_skip_seconds = 0;
+            if (delta !== 0) {
+                this.applySeek(delta);
+            }
+        }, SeekControlManager.SKIP_COALESCE_MS);
+    }
+
+
+    /**
+     * 再生可能範囲内にクランプしてシークする
+     * @param delta_seconds 現在位置からの移動量 (秒、負数で戻し)
+     */
+    private applySeek(delta_seconds: number): void {
+        const video = this.player.video;
+        const end = this.getSeekableEndSeconds();
+        const target = Math.min(Math.max(video.currentTime + delta_seconds, 0), end);
+        if (Math.abs(target - video.currentTime) < 0.05) {
+            return;
+        }
+        this.player.seek(target);
+    }
+
+
+    /**
+     * 現在のメディアでシーク可能な末尾 (秒) を返す
+     * 追いかけ再生中は seekable の末尾 (= 録画先端) を優先し、先端を超えたシークを防ぐ
+     */
+    private getSeekableEndSeconds(): number {
+        const video = this.player.video;
+        if (Number.isFinite(video.duration) && video.duration > 0) {
+            return Math.max(0, video.duration - 0.1);
+        }
+        if (video.seekable.length > 0) {
+            return Math.max(0, video.seekable.end(video.seekable.length - 1) - 0.1);
+        }
+        return video.currentTime;
+    }
+
+
+    /**
+     * 高速シークを開始する (音声をミュートし、一定間隔でシークを繰り返す)
+     * @param direction 方向 (1: 早送り, -1: 巻き戻し)
+     */
+    private startFastSeek(direction: 1 | -1): void {
+        if (this.is_fast_seeking) {
+            return;
+        }
+        this.is_fast_seeking = true;
+        const video = this.player.video;
+        this.was_muted_before_fast_seek = video.muted;
+        video.muted = true;
+        this.player.notice(direction > 0 ? '高速早送り中 (長押し)' : '高速巻き戻し中 (長押し)');
+        const step = direction * SeekControlManager.FAST_SEEK_STEP_SECONDS;
+        this.applySeek(step);
+        this.fast_seek_timer = setInterval(() => {
+            // 先端・先頭に到達したらそれ以上は進めない (applySeek 側でクランプされる)
+            this.applySeek(step);
+        }, SeekControlManager.FAST_SEEK_INTERVAL_MS);
+    }
+
+
+    /**
+     * 高速シークを終了し、ミュート状態を元に戻す
+     */
+    private stopFastSeek(): void {
+        if (this.fast_seek_timer !== null) {
+            clearInterval(this.fast_seek_timer);
+            this.fast_seek_timer = null;
+        }
+        if (this.is_fast_seeking) {
+            this.is_fast_seeking = false;
+            this.player.video.muted = this.was_muted_before_fast_seek;
+        }
+    }
+}
+
+export default SeekControlManager;
