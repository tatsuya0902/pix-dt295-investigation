diff --git a/server/tests/test_live_stream_client_timeout.py b/server/tests/test_live_stream_client_timeout.py
new file mode 100644
index 0000000..a2cf24c
--- /dev/null
+++ b/server/tests/test_live_stream_client_timeout.py
@@ -0,0 +1,86 @@
+import asyncio
+import contextlib
+import unittest
+from unittest.mock import patch
+
+from app.streams.LiveStream import LiveStream, LiveStreamClient
+
+
+class LiveStreamClientTimeoutTest(unittest.IsolatedAsyncioTestCase):
+    """データ待機と出力先の読み取り停滞を区別する。"""
+
+    async def asyncSetUp(self) -> None:
+        # 実時間を待たず、初期化が10秒を超える状況を再現する。
+        self.clock_patch = patch('app.streams.LiveStream.time.time', return_value=1000.0)
+        self.clock = self.clock_patch.start()
+        self.stream = LiveStream(f'test-{self._testMethodName}', '720p')
+        self.client = LiveStreamClient(self.stream, 'mpegts')
+        self.stream._clients = [self.client]
+        self.reader: asyncio.Task[bytes | None] | None = None
+
+    async def asyncTearDown(self) -> None:
+        # 失敗した試験でも待機タスクを次の試験へ残さない。
+        if self.reader is not None:
+            self.reader.cancel()
+            with contextlib.suppress(asyncio.CancelledError):
+                await self.reader
+        self.clock_patch.stop()
+
+    async def testInitialDataAfterLongStartupUsesOriginalClient(self) -> None:
+        """31秒の起動待ち後も同じHTTPクライアントが最初のデータを受け取る。"""
+        self.reader = asyncio.create_task(self.client.readStreamData())
+        await asyncio.sleep(0)
+        self.clock.return_value = 1031.0
+        self.stream.writeStreamData(b'first transport packets')
+        self.assertIn(self.client, self.stream._clients)
+        self.assertEqual(await asyncio.wait_for(self.reader, 0.2), b'first transport packets')
+        self.assertEqual(self.client.stream_data_read_at, 1031.0)
+
+    async def testWaitingReaderAfterTransmissionGapRemainsConnected(self) -> None:
+        """配信途中の入力待ちでも、待機中の読み取りタスクへデータを渡す。"""
+        self.client.writeStreamData(b'first')
+        self.assertEqual(await self.client.readStreamData(), b'first')
+        self.reader = asyncio.create_task(self.client.readStreamData())
+        await asyncio.sleep(0)
+        self.clock.return_value = 1011.0
+        self.stream.writeStreamData(b'next')
+        self.assertIn(self.client, self.stream._clients)
+        self.assertEqual(await asyncio.wait_for(self.reader, 0.2), b'next')
+
+    async def testNonReadingClientStillExpiresAfterTenSeconds(self) -> None:
+        """読み取りを開始しないクライアントの10秒制限は保持する。"""
+        self.clock.return_value = 1011.0
+        self.stream.writeStreamData(b'data')
+        self.assertNotIn(self.client, self.stream._clients)
+
+    async def testBlockedOutputStillExpiresAfterConsumption(self) -> None:
+        """消費後に次の読み取りへ進めない接続も10秒で回収する。"""
+        self.client.writeStreamData(b'first')
+        self.assertEqual(await self.client.readStreamData(), b'first')
+        self.clock.return_value = 1011.0
+        self.stream.writeStreamData(b'next')
+        self.assertNotIn(self.client, self.stream._clients)
+
+    async def testCancelledReadDoesNotRetainTimeoutExemption(self) -> None:
+        """キャンセル済みの読み取りは待機中として扱わない。"""
+        self.reader = asyncio.create_task(self.client.readStreamData())
+        await asyncio.sleep(0)
+        self.reader.cancel()
+        with contextlib.suppress(asyncio.CancelledError):
+            await self.reader
+        self.clock.return_value = 1011.0
+        self.stream.writeStreamData(b'data')
+        self.assertNotIn(self.client, self.stream._clients)
+
+    async def testEncoderEndSentinelReachesWaitingClient(self) -> None:
+        """待機中にエンコーダーが終わった場合は終了通知を返す。"""
+        self.reader = asyncio.create_task(self.client.readStreamData())
+        await asyncio.sleep(0)
+        self.clock.return_value = 1031.0
+        self.client.writeStreamData(None)
+        self.assertIsNone(await asyncio.wait_for(self.reader, 0.2))
+        self.assertEqual(self.client.stream_data_read_at, 1031.0)
+
+
+if __name__ == '__main__':
+    unittest.main()
