+def NormalizeSeriesTitle(title: str) -> str:
+    """
+    ローカル改造: タイトルからシリーズ判定用のキーを生成する
+    話数表記 (#6 / 第3話など) と、[字] などの角括弧注記・【サブタイトル】を取り除き、
+    残った番組名部分だけを返す。シリーズ情報 (series_id) がない録画同士でも、
+    このキーが一致すれば同じシリーズの別話として扱えるようにするためのもの
+
+    Args:
+        title (str): 録画番組のタイトル
+
+    Returns:
+        str: 正規化されたタイトル (シリーズ判定キー)
+    """
+
+    normalized = re.sub(r'【[^】]*】', '', title)  # 【サブタイトル】など
+    normalized = re.sub(r'\[[^\]]*\]', '', normalized)  # [字] [解] [再] など
+    normalized = re.sub(r'#\s*\d+', '', normalized)  # #6 など
+    normalized = re.sub(r'第\s*\d+\s*[話回]', '', normalized)  # 第3話 / 第10回 など
+    normalized = re.sub(r'\s+', ' ', normalized).strip()
+    return normalized
+
+
+async def AttachEpisodeNeighbors(recorded_program: RecordedProgram) -> None:
+    """
+    ローカル改造: 録画番組 API の応答に、同じシリーズの前後の回の録画番組 ID を付与する
+    視聴画面で「前の話」「次の話」ボタンから直接移動できるようにするため、単体取得時にのみ計算する
+    放送開始時刻の前後で最も近い、再生可能な (Recorded / Recording) 録画を対象とする
+    シリーズ情報 (series_id) がない録画については、タイトルから話数表記と括弧注記を除いた
+    番組名が一致する録画同士を同じシリーズとみなすフォールバックで判定する
+    取得に失敗しても番組情報の表示自体は継続できるよう、例外時は None のままにする
+
+    Args:
+        recorded_program (RecordedProgram): 応答に含める録画番組 (ORM モデル)
+    """
+
+    try:
+        recorded_program.next_episode_id = None  # type: ignore[attr-defined]
+        recorded_program.previous_episode_id = None  # type: ignore[attr-defined]
+
+        # シリーズ情報がない場合は、タイトルから判定するフォールバックを使う
+        # (この環境では series_id が付与されない録画が大半のため)
+        if recorded_program.series_id is None:
+            series_key = NormalizeSeriesTitle(recorded_program.title)
+            if len(series_key) < 2:
+                return
+            candidates = await RecordedProgram.all() \
+                .select_related('recorded_video') \
+                .limit(1000)
+            same_series = [
+                candidate for candidate in candidates
+                if candidate.id != recorded_program.id
+                and candidate.recorded_video.status in ('Recorded', 'Recording')
+                and NormalizeSeriesTitle(candidate.title) == series_key
+            ]
+            before = [c for c in same_series if c.start_time < recorded_program.start_time]
+            after = [c for c in same_series if c.start_time > recorded_program.start_time]
+            if len(after) > 0:
+                recorded_program.next_episode_id = min(after, key=lambda c: c.start_time).id  # type: ignore[attr-defined]
+            if len(before) > 0:
+                recorded_program.previous_episode_id = max(before, key=lambda c: c.start_time).id  # type: ignore[attr-defined]
+            return
+
+        # 次の話: 放送開始時刻が後のもののうち、最も近い再生可能な録画
+        next_candidates = await RecordedProgram.all() \
+            .select_related('recorded_video') \
+            .filter(series_id=recorded_program.series_id, start_time__gt=recorded_program.start_time) \
+            .order_by('start_time').limit(10)
+        for candidate in next_candidates:
+            if candidate.recorded_video.status in ('Recorded', 'Recording'):
+                recorded_program.next_episode_id = candidate.id  # type: ignore[attr-defined]
+                break
+
+        # 前の話: 放送開始時刻が前のもののうち、最も近い再生可能な録画
+        previous_candidates = await RecordedProgram.all() \
+            .select_related('recorded_video') \
+            .filter(series_id=recorded_program.series_id, start_time__lt=recorded_program.start_time) \
+            .order_by('-start_time').limit(10)
+        for candidate in previous_candidates:
+            if candidate.recorded_video.status in ('Recorded', 'Recording'):
+                recorded_program.previous_episode_id = candidate.id  # type: ignore[attr-defined]
+                break
+    except Exception as ex:
+        logging.error('[VideosRouter][AttachEpisodeNeighbors] Failed to fetch episode neighbors:', exc_info=ex)
+
+
