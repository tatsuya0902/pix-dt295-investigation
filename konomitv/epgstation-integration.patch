+"""EPGStation を管理元とする、確認済み録画の削除とメタデータ同期。"""
+
+from __future__ import annotations
+
+import asyncio
+import base64
+import hashlib
+import hmac
+import json
+import os
+import secrets
+import stat
+import time
+from pathlib import Path
+from typing import Annotated, Literal
+
+import httpx
+from fastapi import HTTPException
+from pydantic import BaseModel, Field
+
+from app import logging
+from app.constants import BASE_DIR, DATA_DIR
+
+
+class RecorderDeleteConfig(BaseModel):
+    """接続先と保存先の対応。秘密情報は別のローカルファイルから読む。"""
+
+    enabled: bool = False
+    epgstation_url: str
+    recording_root: Path
+    epgstation_recording_root: Path
+    jellyfin_url: str | None = None
+    jellyfin_access_file: Path | None = None
+    jellyfin_recording_root: Path | None = None
+    state_directory: Path = DATA_DIR / 'recorder-delete-sync'
+
+
+class EPGVideoFile(BaseModel):
+    id: int
+    filename: str
+    size: int
+
+
+class EPGRecording(BaseModel):
+    id: int
+    name: str
+    is_recording: Annotated[bool, Field(alias='isRecording')]
+    is_protected: Annotated[bool, Field(alias='isProtected')]
+    is_encoding: Annotated[bool, Field(alias='isEncoding')]
+    video_files: Annotated[list[EPGVideoFile], Field(alias='videoFiles', default_factory=list)]
+
+
+class EPGRecordings(BaseModel):
+    records: list[EPGRecording]
+    total: int
+
+
+class DeleteFileSnapshot(BaseModel):
+    path: str
+    size: int
+    device: int
+    inode: int
+    modified_ns: int
+
+
+class RecordingDeletePlan(BaseModel):
+    video_id: int
+    epgstation_id: int
+    title: str
+    files: list[DeleteFileSnapshot]
+    expires_at: int
+
+
+class RecordingProtection(BaseModel):
+    enabled: bool
+    epgstation_id: int | None = None
+    is_protected: bool | None = None
+
+
+class RecordingProtectionUpdate(BaseModel):
+    epgstation_id: int
+    is_protected: bool
+
+
+class RecordingDeletePreview(BaseModel):
+    enabled: bool
+    plan: RecordingDeletePlan | None = None
+    confirmation_token: str | None = None
+
+
+class DeleteSyncJob(BaseModel):
+    id: Annotated[str, Field(pattern='^[a-z0-9-]{1,80}$')]
+    plan: RecordingDeletePlan | None = None
+    state: Literal['Prepared', 'EPGDeleteRequested', 'MetadataPending', 'JellyfinPending', 'Complete', 'NeedsAttention']
+    attempts: int = 0
+    retry_at: float = 0
+    error: str | None = None
+    jellyfin_refresh_requested: bool = False
+    deleted_paths: Annotated[list[str], Field(description='Externally removed recording paths')] = []
+
+
+class JellyfinItem(BaseModel):
+    path: Annotated[str | None, Field(alias='Path')] = None
+
+
+class JellyfinItems(BaseModel):
+    items: Annotated[list[JellyfinItem], Field(alias='Items')]
+    total: Annotated[int, Field(alias='TotalRecordCount')]
+
+
+def LoadRecorderDeleteConfig() -> RecorderDeleteConfig | None:
+    """設定ファイルがない環境では無効にする。
+
+    Args:
+        なし。
+    Returns:
+        有効な設定、または無効時の None。
+    """
+    path = Path(os.environ.get('KONOMITV_RECORDER_CONFIG', str(BASE_DIR.parent / 'customizations.local.json')))
+    if not path.is_file():
+        return None
+    config = RecorderDeleteConfig.model_validate_json(path.read_text(encoding='utf-8'))
+    if not config.enabled:
+        return None
+    # 接続先は管理者が設定する固定値だけを利用し、録画情報・リクエストから URL を組み立てない。
+    for url in [config.epgstation_url, config.jellyfin_url]:
+        if url is not None and (httpx.URL(url).scheme not in ['http', 'https'] or httpx.URL(url).username):
+            raise ValueError('Invalid recorder integration URL')
+    return config
+
+
+class RecorderDeleteSync:
+    """ファイルを直接 unlink せず、EPGStation の正式 API で削除を委譲する。"""
+
+    def __init__(self, config: RecorderDeleteConfig, client: httpx.AsyncClient | None = None) -> None:
+        """削除・同期の接続と排他制御を初期化する。
+
+        Args:
+            config: ローカル設定。テスト時は専用保存先を指定する。
+            client: モック通信を注入できる HTTP クライアント。
+        Returns:
+            なし。
+        """
+        # 各 API と復旧処理で共有する設定。録画本体の保存先は固定する。
+        self.config = config
+        # EPGStation と Jellyfin への接続。リダイレクトで別サーバーに移動しない。
+        self.client = client or httpx.AsyncClient(timeout=15, follow_redirects=False)
+        # 確認から削除までの競合を、このプロセス内では直列化する。
+        self.lock = asyncio.Lock()
+        # 復旧処理が待機中なら、削除・監視イベントから起こす。
+        self.event = asyncio.Event()
+        # 確認トークンと復旧記録は録画ファイルと別のローカル領域に置く。
+        config.state_directory.mkdir(parents=True, exist_ok=True, mode=0o700)
+        key_path = config.state_directory / 'confirmation.key'
+        try:
+            fd = os.open(key_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+        except FileExistsError:
+            pass
+        else:
+            with os.fdopen(fd, 'wb') as output:
+                output.write(secrets.token_bytes(32))
+        # 再起動をまたいでも有効期限内の確認と復旧が可能な署名鍵。
+        self.key = key_path.read_bytes()
+        if len(self.key) != 32:
+            raise ValueError('Invalid confirmation key; restore the key before enabling deletion')
+
+    def canonicalPath(self, filename: str, require_exists: bool = True) -> Path:
+        """EPGStation の保存先をローカルマウントへ対応付ける。
+
+        Args:
+            filename: EPGStation が返したファイル名。
+            require_exists: 確認時は存在必須。削除後の確認時だけ False。
+        Returns:
+            シンボリックリンクを含まない保存先内の絶対パス。
+        """
+        root = self.config.recording_root.absolute()
+        if root.resolve() != root:
+            raise HTTPException(409, 'Configured storage root must not contain symlinks')
+        source = Path(filename)
+        # 絶対パスを返す構成では、明示された EPGStation 側ルートだけを変換する。
+        if source.is_absolute():
+            try:
+                source = source.relative_to(self.config.epgstation_recording_root.absolute())
+            except ValueError as ex:
+                raise HTTPException(409, 'EPGStation file is outside configured storage') from ex
+        if not source.parts or any(part in ['..', '.'] for part in source.parts):
+            raise HTTPException(409, 'Unsafe recording path')
+        candidate = root / source
+        # 録画ディレクトリ自体や途中の要素がリンクの場合も拒否する。
+        current = root
+        for part in [None, *source.parts]:
+            if part is not None:
+                current = current / part
+            if current.is_symlink():
+                raise HTTPException(409, 'Symlink recording paths cannot be deleted')
+        if not candidate.resolve().is_relative_to(root.resolve()):
+            raise HTTPException(409, 'Recording path escaped configured storage')
+        if require_exists and (not candidate.is_file() or not stat.S_ISREG(candidate.stat().st_mode)):
+            raise HTTPException(409, 'Recording file is missing or is not a regular file')
+        return candidate
+
+    def localPath(self, filename: str, require_exists: bool = True) -> Path:
+        """KonomiTV 側の絶対パスを同じ保存先検証へ通す。
+
+        Args:
+            filename: KonomiTV 側の保存先。
+            require_exists: 削除後だけ False。
+        Returns:
+            検証済みのローカルパス。
+        """
+        try:
+            relative = Path(filename).relative_to(self.config.recording_root.absolute())
+        except ValueError as ex:
+            raise HTTPException(409, 'KonomiTV file is outside configured storage') from ex
+        return self.canonicalPath(str(relative), require_exists)
+
+    def snapshot(self, path: Path) -> DeleteFileSnapshot:
+        """確認画面に表示した実ファイルの同一性を保存する。
+
+        Args:
+            path: 検証済みの保存先。
+        Returns:
+            ファイルのサイズ・識別子・更新時刻。
+        """
+        value = path.stat()
+        return DeleteFileSnapshot(path=str(path), size=value.st_size, device=value.st_dev,
+            inode=value.st_ino, modified_ns=value.st_mtime_ns)
+
+    async def request(self, method: str, path: str) -> httpx.Response:
+        """管理元 API への通信失敗を安全なエラーとして返す。
+
+        Args:
+            method: HTTP メソッド。
+            path: 固定 API パス。
+        Returns:
+            正常応答または存在確認に使う 404 応答。
+        """
+        try:
+            response = await self.client.request(method, self.config.epgstation_url.rstrip('/') + path)
+            if response.status_code != 404:
+                response.raise_for_status()
+            return response
+        except httpx.HTTPError as ex:
+            raise HTTPException(502, 'EPGStation did not confirm the operation; recording was not deleted locally') from ex
+
+    async def recordings(self) -> list[EPGRecording]:
+        """ページングして全録画の管理情報を読む。
+
+        Args:
+            なし。
+        Returns:
+            管理元の録画情報。
+        """
+        result: list[EPGRecording] = []
+        while True:
+            response = await self.request('GET', f'/recorded?isHalfWidth=false&offset={len(result)}&limit=100')
+            page = EPGRecordings.model_validate(response.json())
+            result.extend(page.records)
+            if len(result) >= page.total:
+                return result
+            if not page.records:
+                raise HTTPException(502, 'Incomplete EPGStation recording list')
+
+    async def plan(self, video_id: int, file_path: str, allow_protected: bool = False) -> RecordingDeletePlan:
+        """正規化パスの完全一致で対象を一意にする。
+
+        Args:
+            video_id: KonomiTV の録画 ID。
+            file_path: KonomiTV の DB が保持する保存先。
+            allow_protected: 保護操作の照合時だけ、保護中の録画も許可する。
+        Returns:
+            確認後に署名する削除計画。
+        """
+        target = self.localPath(file_path)
+        matches: list[EPGRecording] = []
+        for record in await self.recordings():
+            for video in record.video_files:
+                try:
+                    path = self.canonicalPath(video.filename, require_exists=False)
+                except HTTPException:
+                    continue
+                if path == target:
+                    matches.append(record)
+        if len(matches) != 1:
+            raise HTTPException(409, 'Recording is unmanaged or has an ambiguous EPGStation mapping')
+        record = matches[0]
+        # 正式削除 API は録画中の停止もできるため、こちらで必ず禁止する。
+        if record.is_recording or (record.is_protected and not allow_protected) or record.is_encoding:
+            raise HTTPException(409, 'Recording is active, protected, or encoding')
+        if not record.video_files or len(record.video_files) > 20:
+            raise HTTPException(409, 'Recording file set cannot be safely confirmed')
+        paths = [self.canonicalPath(video.filename) for video in record.video_files]
+        if len(set(paths)) != len(paths):
+            raise HTTPException(409, 'Duplicate file references in EPGStation')
+        # 同じファイルを別の録画 ID が参照する場合、API が他の録画を壊すため拒否する。
+        records = await self.recordings()
+        for other in records:
+            if other.id == record.id:
+                continue
+            for video in other.video_files:
+                try:
+                    path = self.canonicalPath(video.filename, require_exists=False)
+                except HTTPException:
+                    continue
+                if path in paths:
+                    raise HTTPException(409, 'Another recording references the same file')
+        return RecordingDeletePlan(video_id=video_id, epgstation_id=record.id, title=record.name,
+            files=[self.snapshot(path) for path in paths], expires_at=int(time.time()) + 300)
+
+    async def protectionStates(self, files: dict[int, str]) -> dict[int, bool | None]:
+        """一覧の保護表示用に、管理元を一度だけ読みパスで照合する。
+
+        Args:
+            files: 表示中の録画 ID と DB の保存先。
+        Returns:
+            保護状態。対応が不明・曖昧な録画は None。
+        """
+        by_path: dict[Path, list[EPGRecording]] = {}
+        for record in await self.recordings():
+            for video in record.video_files:
+                try:
+                    path = self.canonicalPath(video.filename, require_exists=False)
+                except HTTPException:
+                    continue
+                by_path.setdefault(path, []).append(record)
+        states: dict[int, bool | None] = {}
+        for video_id, filename in files.items():
+            try:
+                matches = by_path.get(self.localPath(filename, require_exists=False), [])
+                states[video_id] = matches[0].is_protected if len(matches) == 1 else None
+            except HTTPException:
+                states[video_id] = None
+        return states
+
+    async def protection(self, video_id: int, file_path: str) -> RecordingProtection:
+        """保護状態はキャッシュせず、管理元の現在値を読む。
+
+        Args:
+            video_id: KonomiTV の録画 ID。
+            file_path: DB に記録された保存先。
+        Returns:
+            一意に対応した EPGStation の保護状態。
+        """
+        plan = await self.plan(video_id, file_path, allow_protected=True)
+        response = await self.request('GET', f'/recorded/{plan.epgstation_id}?isHalfWidth=false')
+        if response.status_code == 404:
+            raise HTTPException(409, 'Recording no longer exists in EPGStation')
+        record = EPGRecording.model_validate(response.json())
+        if record.id != plan.epgstation_id or record.is_recording or record.is_encoding:
+            raise HTTPException(409, 'Recording state changed')
+        paths = {str(self.canonicalPath(video.filename)) for video in record.video_files}
+        if paths != {file.path for file in plan.files}:
+            raise HTTPException(409, 'Recording file mapping changed')
+        return RecordingProtection(enabled=True, epgstation_id=record.id, is_protected=record.is_protected)
+
+    async def setProtection(self, video_id: int, file_path: str, update: RecordingProtectionUpdate) -> RecordingProtection:
+        """削除と同じロックで、正式 API に保護設定を委譲する。
+
+        Args:
+            video_id: KonomiTV の録画 ID。
+            file_path: DB に記録された保存先。
+            update: 確認した管理元 ID と設定したい状態。
+        Returns:
+            更新後に読み直して確認できた保護状態。
+        """
+        async with self.lock:
+            current = await self.protection(video_id, file_path)
+            if current.epgstation_id != update.epgstation_id:
+                raise HTTPException(409, 'Recording mapping changed; reopen the menu')
+            if current.is_protected != update.is_protected:
+                action = 'protect' if update.is_protected else 'unprotect'
+                response = await self.request('PUT', f'/recorded/{current.epgstation_id}/{action}')
+                if response.status_code == 404:
+                    raise HTTPException(409, 'Recording no longer exists in EPGStation')
+            result = await self.protection(video_id, file_path)
+            if result.is_protected != update.is_protected:
+                raise HTTPException(502, 'EPGStation did not confirm the protection state; reopen the menu')
+            return result
+
+    def sign(self, plan: RecordingDeletePlan) -> str:
+        """確認内容を改ざんできない短期トークンへ変換する。
+
+        Args:
+            plan: 確認画面へ渡す計画。
+        Returns:
+            確認内容と有効期限を含む署名付きトークン。
+        """
+        payload = base64.urlsafe_b64encode(plan.model_dump_json().encode()).decode()
+        signature = hmac.new(self.key, payload.encode(), hashlib.sha256).hexdigest()
+        return payload + '.' + signature
+
+    def verify(self, token: str, video_id: int) -> RecordingDeletePlan:
+        """対象 ID、有効期限、署名のすべてを検証する。
+
+        Args:
+            token: 確認画面から戻った値。
+            video_id: 削除要求の録画 ID。
+        Returns:
+            検証済みの削除計画。
+        """
+        try:
+            if len(token) > 131072:
+                raise ValueError('Token too large')
+            payload, signature = token.rsplit('.', 1)
+            expected = hmac.new(self.key, payload.encode(), hashlib.sha256).hexdigest()
+            if not hmac.compare_digest(signature, expected):
+                raise ValueError('Invalid signature')
+            plan = RecordingDeletePlan.model_validate_json(base64.urlsafe_b64decode(payload))
+            if plan.video_id != video_id or plan.expires_at < time.time():
+                raise ValueError('Expired or mismatched confirmation')
+            return plan
+        except (ValueError, UnicodeError) as ex:
+            raise HTTPException(409, 'Deletion confirmation expired or changed; open confirmation again') from ex
+
+    def saveJob(self, job: DeleteSyncJob) -> None:
+        """再試行記録を原子的に置き換え、認証情報は保存しない。
+
+        Args:
+            job: 同期の状態。
+        Returns:
+            なし。
+        """
+        target = self.config.state_directory / (job.id + '.json')
+        temporary = target.with_suffix('.tmp')
+        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+        with os.fdopen(fd, 'w') as output:
+            output.write(job.model_dump_json())
+            output.flush()
+            os.fsync(output.fileno())
+        temporary.replace(target)
+        self.event.set()
+
+    async def delete(self, video_id: int, file_path: str, token: str) -> DeleteSyncJob:
+        """確認後にも管理情報と実ファイルを照合し、削除を管理元へ委譲する。
+
+        Args:
+            video_id: KonomiTV の録画 ID。
+            file_path: DB の保存先。
+            token: 利用者が確認した内容の署名。
+        Returns:
+            削除確認と KonomiTV の同期が済んだ場合にだけ正常終了。
+        """
+        async with self.lock:
+            confirmed = self.verify(token, video_id)
+            fresh = await self.plan(video_id, file_path)
+            if fresh.epgstation_id != confirmed.epgstation_id or fresh.files != confirmed.files:
+                raise HTTPException(409, 'Recording changed after confirmation')
+            # 成長中ファイルを二重に防ぎ、直前の書き込みも検出する。
+            await asyncio.sleep(0.2)
+            for item in fresh.files:
+                if self.snapshot(self.localPath(item.path)) != item:
+                    raise HTTPException(409, 'Recording file is still changing')
+            # 削除直前にも録画・保護状態と全ファイル集合を再取得する。
+            response = await self.request('GET', f'/recorded/{fresh.epgstation_id}?isHalfWidth=false')
+            if response.status_code == 404:
+                raise HTTPException(409, 'Recording was already removed')
+            current = EPGRecording.model_validate(response.json())
+            if current.is_recording or current.is_protected or current.is_encoding:
+                raise HTTPException(409, 'Recording became active, protected, or encoding')
+            current_files = [self.snapshot(self.canonicalPath(item.filename)) for item in current.video_files]
+            if current_files != fresh.files:
+                raise HTTPException(409, 'EPGStation recording file set changed')
+            job = DeleteSyncJob(id=hashlib.sha256(token.encode()).hexdigest(), plan=confirmed, state='Prepared')
+            self.saveJob(job)
+            job.state = 'EPGDeleteRequested'
+            self.saveJob(job)
+            try:
+                await self.request('DELETE', f'/recorded/{fresh.epgstation_id}')
+                if not await self.confirmRemoved(job):
+                    raise HTTPException(502, 'EPGStation deletion is not yet confirmed; check synchronization status')
+                await self.reconcile(job)
+                if job.state == 'MetadataPending':
+                    raise HTTPException(502, 'Recording was removed; KonomiTV metadata synchronization is pending')
+                return job
+            except Exception:
+                self.event.set()
+                raise
+
+    async def confirmRemoved(self, job: DeleteSyncJob) -> bool:
+        """応答喪失時にも、再削除せず管理情報とファイルの不在を確認する。
+
+        Args:
+            job: 削除要求の記録。
+        Returns:
+            管理情報と全ファイルが消えた場合だけ True。
+        """
+        if job.plan is None:
+            return True
+        response = await self.request('GET', f'/recorded/{job.plan.epgstation_id}?isHalfWidth=false')
+        return response.status_code == 404 and all(
+            not self.localPath(item.path, require_exists=False).exists() for item in job.plan.files
+        )
+
+    async def reconcile(self, job: DeleteSyncJob) -> None:
+        """録画本体の再削除をせずに一覧同期と Jellyfin 更新だけを再試行する。
+
+        Args:
+            job: 永続化済みの同期状態。
+        Returns:
+            なし。失敗は記録し、次の再試行へ渡す。
+        """
+        from app.models.RecordedProgram import RecordedProgram
+
+        if job.state in ['Complete', 'NeedsAttention']:
+            return
+        try:
+            if job.plan is not None and job.state != 'JellyfinPending':
+                if not await self.confirmRemoved(job):
+                    # API 側に録画が残る場合、利用者の新しい確認なしで DELETE を再送しない。
+                    raise RuntimeError('Deletion not confirmed; no destructive retry was performed')
+                job.state = 'MetadataPending'
+                self.saveJob(job)
+                paths = [item.path for item in job.plan.files]
+                # SQLite は JOIN を含む DELETE を扱えないため、照合済みパスから ID を取得して削除する。
+                ids = await RecordedProgram.filter(recorded_video__file_path__in=paths).values_list('id', flat=True)
+                if ids:
+                    await RecordedProgram.filter(id__in=ids).delete()
+            job.state = 'JellyfinPending'
+            self.saveJob(job)
+            if self.config.jellyfin_url is not None:
+                if self.config.jellyfin_access_file is None:
+                    raise RuntimeError('Jellyfin access file is not configured')
+                credentials = json.loads(self.config.jellyfin_access_file.read_text())
+                token: str = credentials['token']
+                headers = {'Authorization': 'MediaBrowser Token="' + token + '"'}
+                # ライブラリ走査は非同期なので、受付応答だけを「一覧から消えた」とは扱わない。
+                if not job.jellyfin_refresh_requested:
+                    response = await self.client.post(self.config.jellyfin_url.rstrip('/') + '/Library/Refresh', headers=headers)
+                    response.raise_for_status()
+                    job.jellyfin_refresh_requested = True
+                    self.saveJob(job)
+                user_id: str = credentials['admin_id']
+                expected_paths = [item.path for item in job.plan.files] if job.plan else job.deleted_paths
+                jellyfin_root = self.config.jellyfin_recording_root or self.config.recording_root
+                expected = {str(jellyfin_root / Path(path).relative_to(self.config.recording_root)) for path in expected_paths}
+                offset = 0
+                while True:
+                    response = await self.client.get(self.config.jellyfin_url.rstrip('/') +
+                        f'/Users/{user_id}/Items?Recursive=true&Fields=Path&StartIndex={offset}&Limit=100', headers=headers)
+                    response.raise_for_status()
+                    page = JellyfinItems.model_validate(response.json())
+                    if any(item.path in expected for item in page.items):
+                        raise RuntimeError('Jellyfin scan has not removed the recording yet')
+                    offset += len(page.items)
+                    if offset >= page.total:
+                        break
+                    if not page.items:
+                        raise RuntimeError('Incomplete Jellyfin item list')
+            job.state = 'Complete'
+            job.error = None
+            self.saveJob(job)
+        except Exception as ex:
+            job.attempts += 1
+            job.retry_at = time.time() + min(3600, 30 * 2 ** min(job.attempts, 7))
+            # URL・トークンなどを例外文字列から記録しない。
+            job.error = type(ex).__name__
+            self.saveJob(job)
+            logging.warning('[RecorderDeleteSync] Metadata synchronization deferred.')
+
+    def jobs(self) -> list[DeleteSyncJob]:
+        """ローカルの復旧記録を読む。
+
+        Args:
+            なし。
+        Returns:
+            同期状態の一覧。
+        """
+        result: list[DeleteSyncJob] = []
+        for path in self.config.state_directory.glob('*.json'):
+            try:
+                result.append(DeleteSyncJob.model_validate_json(path.read_text()))
+            except ValueError:
+                # 壊れた記録を消さずに残し、ほかの同期要求まで停止させない。
+                logging.error('[RecorderDeleteSync] Invalid synchronization journal requires manual review.')
+        return result
+
+    def queueExternalRefresh(self, file_path: str) -> None:
+        """既存スキャナーが検出した外部削除を、ひとつの更新要求へまとめる。
+
+        Args:
+            file_path: 消失した録画の保存先。
+        Returns:
+            なし。
+        """
+        path = self.localPath(file_path, require_exists=False)
+        if path.exists():
+            return
+        # 自身が委譲した削除の監視通知なら、既存ジョブに任せて二重走査を避ける。
+        for job in self.jobs():
+            if job.plan is not None and job.state not in ['Complete', 'NeedsAttention']:
+                if any(item.path == str(path) for item in job.plan.files):
+                    return
+        previous = next((job for job in self.jobs() if job.id == 'external-library-refresh' and job.state != 'Complete'), None)
+        paths: list[str] = list(previous.deleted_paths) if previous else []
+        if str(path) not in paths:
+            paths.append(str(path))
+        self.saveJob(DeleteSyncJob(id='external-library-refresh', state='JellyfinPending',
+            retry_at=time.time() + 3, deleted_paths=paths))
+
+    async def runWorker(self) -> None:
+        """保留ジョブがあるときだけネットワークを使用する。
+
+        Args:
+            なし。
+        Returns:
+            停止要求で終了する。
+        """
+        while True:
+            self.event.clear()
+            async with self.lock:
+                pending = [job for job in self.jobs() if job.state not in ['Complete', 'NeedsAttention']]
+                for job in pending:
+                    if job.retry_at <= time.time():
+                        await self.reconcile(job)
+                pending = [job for job in self.jobs() if job.state not in ['Complete', 'NeedsAttention']]
+            timeout = max(1, min(job.retry_at - time.time() for job in pending)) if pending else None
+            try:
+                await asyncio.wait_for(self.event.wait(), timeout=timeout)
+            except TimeoutError:
+                pass
+
+
+_service: RecorderDeleteSync | None = None
+
+
+def GetRecorderDeleteSync() -> RecorderDeleteSync | None:
+    """有効時だけサービスを遅延生成する。
+
+    Args:
+        なし。
+    Returns:
+        サービス、または無効時の None。
+    """
+    global _service
+    if _service is None:
+        config = LoadRecorderDeleteConfig()
+        if config is not None:
+            _service = RecorderDeleteSync(config)
+    return _service
