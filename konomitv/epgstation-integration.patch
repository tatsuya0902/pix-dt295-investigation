+++ b/server/app/routers/RecorderRouter.py
@@ -0,0 +1,117 @@
+"""録画削除連動の状態確認と、保留中メタデータ同期の実行。"""
+
+import asyncio
+from typing import Annotated
+
+from fastapi import APIRouter, Depends, Query
+from pydantic import BaseModel
+
+from app.models.RecordedProgram import RecordedProgram
+from app.models.User import User
+from app.routers.UsersRouter import GetCurrentAdminUser, GetCurrentUser
+from app.utils.RecorderDeleteSync import DeleteSyncJob, GetRecorderDeleteSync
+
+
+router = APIRouter(tags=['Recorder'], prefix='/api/recorder')
+_worker: asyncio.Task[None] | None = None
+
+
+class RecorderDeleteSyncStatus(BaseModel):
+    enabled: bool
+    jobs: list[DeleteSyncJob]
+
+
+class RecordingProtectionBadges(BaseModel):
+    enabled: bool
+    states: dict[int, bool | None]
+
+
+@router.get('/protection', response_model=RecordingProtectionBadges)
+async def RecordingProtectionBadgesAPI(
+    video_ids: Annotated[list[int], Query(min_length=1, max_length=60)],
+    current_user: Annotated[User, Depends(GetCurrentUser)],
+):
+    """表示中の録画だけの保護状態を返す。パスや管理元 ID は返さない。
+
+    Args:
+        video_ids: 表示対象。最大60件。
+        current_user: 認証済みの視聴者または管理者。
+    Returns:
+        保護状態。管理外・曖昧な録画は None。
+    """
+    ids = list(dict.fromkeys(video_ids))
+    service = GetRecorderDeleteSync()
+    if service is None:
+        return RecordingProtectionBadges(enabled=False, states=dict.fromkeys(ids))
+    programs = await RecordedProgram.filter(id__in=ids).select_related('recorded_video')
+    states: dict[int, bool | None] = dict.fromkeys(ids)
+    states.update(await service.protectionStates({program.id: program.recorded_video.file_path for program in programs}))
+    return RecordingProtectionBadges(enabled=True, states=states)
+
+
+@router.get('/delete-sync', response_model=RecorderDeleteSyncStatus)
+async def RecorderDeleteSyncStatusAPI(current_user: Annotated[User, Depends(GetCurrentAdminUser)]):
+    """管理者へ失敗・保留を含めた同期状態を返す。
+
+    Args:
+        current_user: 認証済み管理者。
+    Returns:
+        同期状態。認証情報・確認トークンは含めない。
+    """
+    service = GetRecorderDeleteSync()
+    return RecorderDeleteSyncStatus(enabled=service is not None, jobs=service.jobs() if service else [])
+
+
+@router.post('/delete-sync/retry', status_code=202)
+async def RecorderDeleteSyncRetryAPI(current_user: Annotated[User, Depends(GetCurrentAdminUser)]):
+    """保留中の一覧同期だけを再試行する。EPGStation の DELETE は再送しない。
+
+    Args:
+        current_user: 認証済み管理者。
+    Returns:
+        更新要求の受付状態。
+    """
+    service = GetRecorderDeleteSync()
+    if service:
+        for job in service.jobs():
+            if job.state not in ['Complete', 'NeedsAttention']:
+                job.retry_at = 0
+                job.jellyfin_refresh_requested = False
+                service.saveJob(job)
+
+
+@router.on_event('startup')
+async def StartRecorderDeleteSyncWorker() -> None:
+    """有効な環境だけで、復旧用ワーカーを開始する。
+
+    Args:
+        なし。
+    Returns:
+        なし。
+    """
+    global _worker
+    service = GetRecorderDeleteSync()
+    if service is not None and _worker is None:
+        _worker = asyncio.create_task(service.runWorker())
+
+
+@router.on_event('shutdown')
+async def StopRecorderDeleteSyncWorker() -> None:
+    """保留状態を残したまま停止する。
+
+    Args:
+        なし。
+    Returns:
+        なし。
+    """
+    global _worker
+    if _worker is not None:
+        _worker.cancel()
+        try:
+            await _worker
+        except asyncio.CancelledError:
+            pass
+        _worker = None
+    service = GetRecorderDeleteSync()
+    if service:
+        await service.client.aclose()
