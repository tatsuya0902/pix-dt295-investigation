--- /dev/null
+++ b/client/src/services/RecordingProtectionBadges.ts
@@ -0,0 +1,45 @@
+import { reactive } from 'vue';
+
+import APIClient from '@/services/APIClient';
+
+/** 一覧の表示用。削除の安全確認には常に管理元の最新値を使う。 */
+export const recordingProtectionBadges = reactive(new Map<number, boolean | null>());
+const versions = new Map<number, number>();
+const pending = new Set<number>();
+let scheduled = false;
+
+export function updateRecordingProtectionBadge(id: number, value: boolean | null): void {
+    versions.set(id, (versions.get(id) ?? 0) + 1);
+    recordingProtectionBadges.set(id, value);
+}
+
+/** 同じ描画周期のカードをまとめ、カードごとのAPI呼び出しや定期ポーリングを避ける。 */
+export function requestRecordingProtectionBadge(id: number): void {
+    versions.set(id, (versions.get(id) ?? 0) + 1);
+    pending.add(id);
+    if (scheduled) return;
+    scheduled = true;
+    queueMicrotask(() => { void flush(); });
+}
+
+async function flush(): Promise<void> {
+    scheduled = false;
+    const ids = [...pending];
+    pending.clear();
+    for (let offset = 0; offset < ids.length; offset += 60) {
+        const batch = ids.slice(offset, offset + 60);
+        const expected = new Map(batch.map(id => [id, versions.get(id)]));
+        const query = new URLSearchParams(batch.map(id => ['video_ids', String(id)]));
+        try {
+            const response = await APIClient.get<{enabled: boolean; states: Record<string, boolean | null>}>(`/recorder/protection?${query}`);
+            for (const id of batch) {
+                // 操作後に、古い一覧取得結果で保護表示を巻き戻さない。
+                if (versions.get(id) !== expected.get(id)) continue;
+                recordingProtectionBadges.set(id, response.type === 'success' && response.data.enabled ? response.data.states[String(id)] ?? null : null);
+            }
+        } catch {
+            // 不明を「未保護」と断定しない。実際の削除・解除時には別途確認する。
+            for (const id of batch) if (versions.get(id) === expected.get(id)) recordingProtectionBadges.set(id, null);
+        }
+    }
+}
