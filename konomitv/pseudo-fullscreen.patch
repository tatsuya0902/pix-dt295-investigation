diff --git a/client/tests/fullscreen.test.mjs b/client/tests/fullscreen.test.mjs
new file mode 100644
index 0000000..2e2fbed
--- /dev/null
+++ b/client/tests/fullscreen.test.mjs
@@ -0,0 +1,144 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import test from 'node:test';
+
+import ts from 'typescript';
+
+
+// 実際のプレイヤーメソッドを実行し、DOM/ブラウザ API の有無だけを差し替える。
+const path = process.env.FULLSCREEN_SOURCE ?? new URL('../src/services/player/PlayerController.ts', import.meta.url);
+const source = ts.createSourceFile('PlayerController.ts', fs.readFileSync(path, 'utf8'), ts.ScriptTarget.Latest, true);
+const controller = source.statements.find(node => ts.isClassDeclaration(node) && node.name.text === 'PlayerController');
+const method = controller.members.find(node => node.name?.getText(source) === 'setupFullscreenHandler');
+const code = ts.transpileModule(`class Harness { ${method.getText(source)} }`, {
+    compilerOptions: {target: ts.ScriptTarget.ES2022},
+}).outputText;
+
+function makeHarness() {
+    const document = new EventTarget();
+    document.body = {};
+    document.fullscreenElement = null;
+    const screen = {orientation: {lock: async () => {}, unlock: () => {}}};
+    const store = {is_fullscreen: false, is_pseudo_fullscreen: false};
+    const Harness = new Function('document', 'screen', 'usePlayerStore', 'assert', `${code}; return Harness;`)(
+        document, screen, () => store, assert,
+    );
+    const instance = new Harness();
+    instance.player = {fullScreen: {}, notice: () => {}};
+    instance.destroying = false;
+    instance.destroyed = false;
+    instance.fullscreen_handler_cleanup = null;
+    return {instance, document, store};
+}
+
+test('API がない場合も同じプレイヤーで字幕・コメントを含む表示へ切り替え、再押下で戻る', () => {
+    const {instance, store} = makeHarness();
+    const player = instance.player;
+    instance.setupFullscreenHandler();
+    player.fullScreen.request();
+    assert.equal(instance.player, player);
+    assert.equal(store.is_pseudo_fullscreen, true);
+    assert.equal(player.fullScreen.isFullScreen(), true);
+    player.fullScreen.request();
+    assert.equal(store.is_pseudo_fullscreen, false);
+    assert.equal(store.is_fullscreen, false);
+});
+
+test('標準 API の成功とネイティブ終了を同期し、擬似全画面へ変更しない', async () => {
+    const {instance, document, store} = makeHarness();
+    document.body.requestFullscreen = async () => {
+        document.fullscreenElement = document.body;
+        document.dispatchEvent(new Event('fullscreenchange'));
+    };
+    document.exitFullscreen = async () => {
+        document.fullscreenElement = null;
+        document.dispatchEvent(new Event('fullscreenchange'));
+    };
+    instance.setupFullscreenHandler();
+    instance.player.fullScreen.request();
+    await Promise.resolve();
+    assert.equal(store.is_fullscreen, true);
+    assert.equal(store.is_pseudo_fullscreen, false);
+    instance.player.fullScreen.cancel();
+    assert.equal(store.is_fullscreen, false);
+});
+
+test('webkit 接頭辞の全画面 API も維持する', () => {
+    const {instance, document, store} = makeHarness();
+    document.body.webkitRequestFullscreen = () => {
+        document.webkitFullscreenElement = document.body;
+        document.dispatchEvent(new Event('webkitfullscreenchange'));
+    };
+    document.webkitExitFullscreen = () => {
+        document.webkitFullscreenElement = null;
+        document.dispatchEvent(new Event('webkitfullscreenchange'));
+    };
+    instance.setupFullscreenHandler();
+    instance.player.fullScreen.request();
+    assert.equal(store.is_fullscreen, true);
+    assert.equal(store.is_pseudo_fullscreen, false);
+    instance.player.fullScreen.cancel();
+    assert.equal(store.is_fullscreen, false);
+});
+
+test('API の同期例外を擬似全画面へフォールバックする', () => {
+    const {instance, document, store} = makeHarness();
+    document.body.requestFullscreen = () => { throw new Error('not supported'); };
+    instance.setupFullscreenHandler();
+    instance.player.fullScreen.request();
+    assert.equal(store.is_pseudo_fullscreen, true);
+});
+
+test('API の非同期拒否を擬似全画面へフォールバックする', async () => {
+    const {instance, document, store} = makeHarness();
+    document.body.requestFullscreen = () => Promise.reject(new Error('not permitted'));
+    instance.setupFullscreenHandler();
+    instance.player.fullScreen.request();
+    await Promise.resolve();
+    assert.equal(store.is_pseudo_fullscreen, true);
+});
+
+test('破棄したプレイヤーの非同期拒否で表示を再度切り替えない', async () => {
+    const {instance, document, store} = makeHarness();
+    document.body.requestFullscreen = () => Promise.reject(new Error('not permitted'));
+    instance.setupFullscreenHandler();
+    instance.player.fullScreen.request();
+    instance.player = null;
+    instance.destroyed = true;
+    await Promise.resolve();
+    assert.equal(store.is_pseudo_fullscreen, false);
+});
+
+test('Escape で解除し、イベントの後片付け後は古いプレイヤーを操作しない', () => {
+    const {instance, document, store} = makeHarness();
+    instance.setupFullscreenHandler();
+    instance.player.fullScreen.request();
+    const escape = new Event('keydown', {cancelable: true});
+    Object.defineProperty(escape, 'key', {value: 'Escape'});
+    document.dispatchEvent(escape);
+    assert.equal(store.is_pseudo_fullscreen, false);
+    assert.equal(escape.defaultPrevented, true);
+    instance.fullscreen_handler_cleanup();
+    instance.player.fullScreen.request();
+    document.dispatchEvent(escape);
+    assert.equal(store.is_pseudo_fullscreen, true);
+});
+
+test('再初期化は擬似全画面状態を保持し、イベントを重複登録しない', () => {
+    const {instance, document, store} = makeHarness();
+    let additions = 0;
+    let removals = 0;
+    const add = document.addEventListener.bind(document);
+    const remove = document.removeEventListener.bind(document);
+    document.addEventListener = (...args) => { additions++; add(...args); };
+    document.removeEventListener = (...args) => { removals++; remove(...args); };
+    instance.setupFullscreenHandler();
+    instance.player.fullScreen.request();
+    instance.setupFullscreenHandler();
+    assert.equal(store.is_pseudo_fullscreen, true);
+    assert.equal(additions - removals, 3);
+    instance.player.fullScreen.cancel();
+    assert.equal(store.is_fullscreen, false);
+    instance.fullscreen_handler_cleanup();
+    assert.equal(additions - removals, 0);
+});
