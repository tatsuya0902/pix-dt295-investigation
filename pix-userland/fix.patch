new file mode 100644
index 0000000..f9174ad
--- /dev/null
+++ b/tests/test_crypto_mix.c
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Verify the optimized AES column transform against its field definition. */
+#include "../src/crypto.c"
+#include <assert.h>
+#include <stdio.h>
+
+static uint8_t reference_multiply(uint8_t value, unsigned factor) {
+    unsigned result = 0, polynomial = value;
+    while (factor) {
+        if (factor & 1U) result ^= polynomial;
+        polynomial <<= 1;
+        if (polynomial & 0x100U) polynomial ^= 0x11bU;
+        factor >>= 1;
+    }
+    return (uint8_t)result;
+}
+static void check_column_transform(const uint8_t input[16], int inverse) {
+    static const unsigned coefficients[2][4] = {{2, 3, 1, 1}, {14, 11, 13, 9}};
+    uint8_t actual[16], expected[16] = {0};
+    memcpy(actual, input, sizeof(actual));
+    for (unsigned column = 0; column < 4; ++column)
+        for (unsigned row = 0; row < 4; ++row)
+            for (unsigned k = 0; k < 4; ++k)
+                expected[4 * column + row] ^=
+                    reference_multiply(input[4 * column + k],
+                                       coefficients[inverse][(k + 4 - row) % 4]);
+    mix(actual, inverse);
+    assert(memcmp(actual, expected, sizeof(actual)) == 0);
+}
+int main(void) {
+    uint8_t input[16] = {0};
+    /* Both transforms are linear over GF(2). Check every byte value at each
+     * position, then combinations with deterministic synthetic data. */
+    for (unsigned position = 0; position < 16; ++position)
+        for (unsigned value = 0; value < 256; ++value) {
+            memset(input, 0, sizeof(input));
+            input[position] = (uint8_t)value;
+            check_column_transform(input, 0);
+            check_column_transform(input, 1);
+        }
+    uint32_t state = 0x12345678U;
+    for (unsigned sample = 0; sample < 4096; ++sample) {
+        for (unsigned i = 0; i < sizeof(input); ++i) {
+            state ^= state << 13;
+            state ^= state >> 17;
+            state ^= state << 5;
+            input[i] = (uint8_t)state;
+        }
+        check_column_transform(input, 0);
+        check_column_transform(input, 1);
+    }
+    puts("AES MixColumns/InvMixColumns: 16384 field-reference comparisons passed");
+    return 0;
+}
